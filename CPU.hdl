// Hack CPU: combines A register, D register, ALU and program counter.
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // A-instruction or C-instruction destination selection.
    Not(in=instruction[15], out=isA);
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    Or(a=isA, b=instruction[5], out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // D register is loaded only by a C-instruction with d2 set.
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ALU operands and control bits.
    And(a=instruction[15], b=instruction[12], out=useM);
    Mux16(a=aOut, b=inM, sel=useM, out=aluY);
    ALU(x=dOut, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // Memory write enable.
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump decision for C-instructions.
    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);
    And(a=notNg, b=notZr, out=positive);
    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=positive, out=jgtPart);
    Or(a=jlt, b=jeq, out=jump1);
    Or(a=jump1, b=jgtPart, out=jumpCond);
    And(a=instruction[15], b=jumpCond, out=doJump);

    PC(in=aOut, load=doJump, inc=true, reset=reset, out[0..14]=pc);
}
